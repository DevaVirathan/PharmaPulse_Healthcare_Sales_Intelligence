# Copy to .env and adjust for your local PostgreSQL instance.
# Never commit your real .env file.

# Preferred: separate database fields. SQLAlchemy handles special characters
# in DB_PASSWORD, so no manual URL-encoding is needed.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=pharmapulse
DB_USER=pharmapulse
DB_PASSWORD=change-me
# DB_DRIVER=postgresql+psycopg

# Optional full-URL override. If set, it takes precedence over DB_* fields.
# If you use it, URL-encode special characters in the password (for example
# p@ss -> p%40ss).
# DATABASE_URL=postgresql+psycopg://pharmapulse:change-me@localhost:5432/pharmapulse

APP_NAME=PharmaPulse
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173

# Ingestion limits
MAX_UPLOAD_SIZE_MB=5
MAX_IMPORT_ROWS=50000
